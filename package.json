{
  "name": "@vt-labs/root",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "lint": "oxlint",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "validate": "pnpm lint && pnpm format:check && pnpm jscpd && turbo run typecheck build && pnpm test",
    "storybook": "pnpm --filter @vt-labs/storybook dev",
    "build-storybook": "turbo run build-storybook",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "turbo run build --filter='./packages/*' && changeset publish",
    "lint:fix": "oxlint --fix",
    "lint:types": "oxlint --type-aware",
    "lint:eslint": "eslint . --cache --cache-location node_modules/.cache/eslint",
    "lint:eslint:fix": "eslint . --fix --cache --cache-location node_modules/.cache/eslint",
    "jscpd": "jscpd",
    "prepare": "husky",
    "validate:ci": "pnpm lint && pnpm lint:eslint && pnpm format:check && pnpm jscpd && turbo run typecheck build && pnpm test",
    "test:cov": "vitest run --coverage"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@storybook/addon-vitest": "catalog:",
    "@types/node": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "^10.9.1",
    "eslint-plugin-jest-dom": "^5.10.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-storybook": "catalog:",
    "eslint-plugin-testing-library": "^7.16.2",
    "husky": "^9.1.7",
    "jscpd": "^5.0.16",
    "lint-staged": "^17.4.1",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "storybook": "catalog:",
    "turbo": "^2.10.12",
    "typescript": "catalog:",
    "typescript-eslint": "^8.68.0",
    "vitest": "catalog:"
  }
}
