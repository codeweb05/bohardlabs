# Off on purpose. The default (true) silently installs whatever a package declares as a
# peer, which is exactly the mistake a library repo must not hide: a peer that resolves
# only because pnpm filled it in here will fail in a consumer's install. Every peer a
# package needs to build or test against is listed in its own devDependencies.
auto-install-peers=false
strict-peer-dependencies=false
