{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // A consumer on `moduleResolution: node16` reads the emitted .d.ts files with Node's
    // ESM rules, where a relative import needs its `.js` extension. `nodenext` here makes a
    // missing one a build error instead of types that silently resolve to `any`. Only the
    // build uses it: tests import packages whose CommonJS-shaped types it would reject.
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": false,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src"],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.typetest.ts",
    "src/**/*.stories.tsx",
    "src/stories",
    "src/test"
  ]
}
